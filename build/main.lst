 103:Core/Src/main.c ****   // Flash memory'den elde ettiginiz deger 7'den buyukse (veya bos olan 0xFFFFFFFF ise) [cite: 48]
 104:Core/Src/main.c ****   uint32_t flash_val = Read_Blink_Count_From_Flash();
 105:Core/Src/main.c **** 
 106:Core/Src/main.c ****   if (flash_val == 0xFFFFFFFF || flash_val > 7) {
 107:Core/Src/main.c ****       blink_count = 4; // degerini 4 yapin [cite: 48]
 108:Core/Src/main.c ****       Save_Blink_Count_To_Flash(blink_count);
 109:Core/Src/main.c ****   } else {
 110:Core/Src/main.c ****       blink_count = flash_val;
 111:Core/Src/main.c ****   }
 112:Core/Src/main.c **** 
 113:Core/Src/main.c ****   // TIM2'yi kesme (interrupt) modunda baslat [cite: 36]
 114:Core/Src/main.c ****   HAL_TIM_Base_Start_IT(&htim2);
 115:Core/Src/main.c ****   /* USER CODE END 2 */
 116:Core/Src/main.c **** 
 117:Core/Src/main.c ****   /* Infinite loop */
 118:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 119:Core/Src/main.c ****   while (1)
 120:Core/Src/main.c ****   {
 121:Core/Src/main.c ****       // Butona basildiysa (A0 pini Lojik 0)
 122:Core/Src/main.c ****       if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET) {
 123:Core/Src/main.c ****           if (!button_pressed) {
 124:Core/Src/main.c ****               button_pressed = 1;
 125:Core/Src/main.c ****               button_press_time = HAL_GetTick();
 126:Core/Src/main.c ****               long_press_handled = 0;
 127:Core/Src/main.c ****           } else {
 128:Core/Src/main.c ****               // Buton en az 3 saniye basili tutulursa sistem fabrika ayarlarina donsun [cite: 50]
 129:Core/Src/main.c ****               if (!long_press_handled && (HAL_GetTick() - button_press_time) >= 3000) {
 130:Core/Src/main.c ****                   blink_count = 4; // blink_count degeri 4 olsun [cite: 51]
 131:Core/Src/main.c ****                   Save_Blink_Count_To_Flash(blink_count);
 132:Core/Src/main.c ****                   long_press_handled = 1; 
 133:Core/Src/main.c ****               }
 134:Core/Src/main.c ****           }
 135:Core/Src/main.c ****       } else {
 136:Core/Src/main.c ****           // Buton birakildiysa
 137:Core/Src/main.c ****           if (button_pressed) {
 138:Core/Src/main.c ****               uint32_t press_duration = HAL_GetTick() - button_press_time;
 139:Core/Src/main.c ****               
 140:Core/Src/main.c ****               // 50ms debouncing ile kisa basim algilamasi
 141:Core/Src/main.c ****               if (press_duration > 50 && press_duration < 3000 && !long_press_handled) {
 142:Core/Src/main.c ****                   blink_count++; // butona her basildiginda blink count degeri 1 artsin [cite: 43]
 143:Core/Src/main.c ****                   if (blink_count > 7) {
 144:Core/Src/main.c ****                       blink_count = 4; // degeri 7 iken butona basilirsa blink count degeri 4 olsun
 145:Core/Src/main.c ****                   }
ARM GAS  C:\msys64\tmp\ccGd2ADx.s 			page 4


 146:Core/Src/main.c ****                   Save_Blink_Count_To_Flash(blink_count);
 147:Core/Src/main.c ****               }
 148:Core/Src/main.c ****               button_pressed = 0;
 149:Core/Src/main.c ****           }
 150:Core/Src/main.c ****       }
 151:Core/Src/main.c ****     /* USER CODE END WHILE */
 152:Core/Src/main.c **** 
 153:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 154:Core/Src/main.c ****   }
 155:Core/Src/main.c ****   /* USER CODE END 3 */
 156:Core/Src/main.c **** }
